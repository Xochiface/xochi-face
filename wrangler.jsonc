// Cloudflare hosting for the live site: a static export served as plain files.
// `npm run build` writes out/ (next.config.ts), and Cloudflare serves it from
// its network. Static file requests are free and unlimited on the free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xochi-face",
  "compatibility_date": "2026-11-01",
  // The site's addresses. Cloudflare attaches these (with HTTPS certificates)
  // on deploy; the domain's DNS is on Cloudflare since 2026-11-21.
  "routes": [
    { "pattern": "xochiface.com", "custom_domain": true },
    { "pattern": "www.xochiface.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    // /about serves about.html; /about/ redirects to /about.
    "html_handling": "auto-trailing-slash",
    // Unknown addresses get the site's own 404 page.
    "not_found_handling": "404-page"
  }
}
